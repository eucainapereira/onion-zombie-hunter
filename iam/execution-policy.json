{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaCloudWatchLogsWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws/lambda/onion-zh-*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/onion-zh-*:*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
